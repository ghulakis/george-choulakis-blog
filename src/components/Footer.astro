---
const base = import.meta.env.BASE_URL;
---
<footer>
  <div class="container footer-inner">
    <div>
      <strong>George Choulakis</strong>
      <p>Data · systems · automation · a few rubber ducks</p>
    </div>
    <div class="links">
      <a href="https://github.com/ghulakis">GitHub</a>
      <a href={`${base}blog/`}>Writing</a>
      <a href="mailto:hello@georgechoulakis.com">Email</a>
    </div>
    <p class="mono tiny">© {new Date().getFullYear()}</p>
  </div>
</footer>

<style>
footer { border-top:1px solid var(--border); margin-top:90px; padding:36px 0 48px; background:rgba(255,255,255,.45); }
.footer-inner { display:grid; grid-template-columns:1fr auto auto; align-items:start; gap:30px; color:var(--muted); font-size:.9rem; }
strong { color:var(--text); }
p { margin:.25rem 0 0; }
.links { display:flex; gap:18px; }
.links a:hover { color:var(--text); }
.tiny { font-size:.76rem; }
@media(max-width:700px){ .footer-inner{grid-template-columns:1fr;} }
</style>
