---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer>
  <div class="container footer-inner">
    <div>
      <strong>George Choulakis</strong>
      <p>Data · systems · automation · a few rubber ducks</p>
      <a
        class="visit-counter"
        href="https://hits.sh/ghulakis.github.io/george-choulakis-blog/"
        target="_blank"
        rel="noreferrer"
        aria-label="View homepage hit statistics"
        title="Homepage visits"
      >
        <img
          src="https://hits.sh/ghulakis.github.io/george-choulakis-blog.svg?style=flat-square&label=homepage%20visits&color=9db4c8&labelColor=f7f3ea"
          alt="Homepage visit counter"
          loading="lazy"
        />
      </a>
    </div>
    <div class="links">
      <a href="https://github.com/ghulakis">GitHub</a>
      <a href={`${base}/blog/`}>Writing</a>
      <a href="https://www.linkedin.com/in/george-choulakis/" target="_blank" rel="noreferrer">LinkedIn</a>
    </div>
    <p class="mono tiny">© {new Date().getFullYear()}</p>
  </div>
</footer>

<style>
footer { border-top:1px solid var(--border); margin-top:90px; padding:36px 0 48px; background:rgba(255,255,255,.45); }
.footer-inner { display:grid; grid-template-columns:1fr auto auto; align-items:start; gap:30px; color:var(--muted); font-size:.9rem; }
strong { color:var(--text); }
p { margin:.25rem 0 0; }
.links { display:flex; gap:18px; }
.links a:hover { color:var(--text); }
.tiny { font-size:.76rem; }
.visit-counter { display:inline-flex; margin-top:12px; opacity:.9; transition:opacity .18s ease, transform .18s ease; }
.visit-counter:hover { opacity:1; transform:translateY(-1px); }
.visit-counter img { height:26px; width:auto; display:block; }
@media(max-width:700px){ .footer-inner{grid-template-columns:1fr;} }
</style>
