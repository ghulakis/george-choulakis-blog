---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path: string) => `${base}/${path.replace(/^\//, '')}`;
const links = [
  { href: url('/'), label: 'Home' },
  { href: url('/about/'), label: 'About' },
  { href: url('/how-i-think/'), label: 'How I think' },
  { href: url('/timeline/'), label: 'Timeline' },
  { href: url('/blog/'), label: 'Writing' },
  { href: url('/projects/'), label: 'Projects' },
];
---
<header class="site-header">
  <div class="container nav">
    <a class="brand" href={url('/')}>
      <img class="brand-face" src={url('/icons/george-face.webp')} alt="" width="34" height="34" />
      George Choulakis
    </a>
    <nav aria-label="Main navigation">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a class="contact" href="https://www.linkedin.com/in/george-choulakis/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
    </nav>
  </div>
</header>

<style>
.site-header { padding: 22px 0; position: relative; z-index: 10; }
.nav { display:flex; align-items:center; justify-content:space-between; gap:24px; }
.brand { display:flex; align-items:center; gap:10px; font-weight:800; letter-spacing:-.02em; }
.brand-face { width:34px; height:34px; border-radius:50%; border:1.5px solid #111; box-shadow:2px 2px 0 #111; background:#EAF2FA; }
nav { display:flex; align-items:center; gap:16px; flex-wrap:wrap; }
nav a { color:var(--muted); font-size:.88rem; font-weight:600; }
nav a:hover { color:var(--text); }
.contact { border:1.5px solid #111; color:var(--text); padding:8px 13px; border-radius:999px; background:#fff; box-shadow:2px 2px 0 #111; }
@media (max-width:900px){
  nav a:not(.contact) { display:none; }
  .brand { font-size:.95rem; }
}
</style>
