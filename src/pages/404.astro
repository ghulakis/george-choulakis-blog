---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Page not found — George Choulakis">
  <main class="container lost">
    <img class="char" src={`${base}/illustrations/characters/duck-swimming.webp`} alt="A rubber duck floating on water" />
    <p class="eyebrow">404</p>
    <h1>Lost? Even the duck is.</h1>
    <p>This page doesn't exist, or it moved while nobody was looking.</p>
    <a href={`${base}/`}>Back to the homepage →</a>
  </main>
</BaseLayout>

<style>
.lost { min-height:60vh; display:grid; justify-items:center; align-content:center; text-align:center; gap:10px; padding:80px 0; }
.lost .char { width:clamp(160px,24vw,240px); margin-bottom:10px; }
h1 { font-size:clamp(2.6rem,6vw,4.6rem); letter-spacing:-.05em; line-height:1; margin:6px 0; }
p { color:var(--muted); }
a { margin-top:14px; padding:12px 18px; border:1.5px solid #111; border-radius:999px; font-weight:800; background:#fff; box-shadow:3px 3px 0 var(--yellow); }
</style>
