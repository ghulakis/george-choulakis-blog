---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path: string) => `${base}/${path.replace(/^\//, '')}`;
---
<BaseLayout>
  <main>
    <section class="hero container">
      <div class="copy">
        <p class="eyebrow">hello, i’m george 👋</p>
        <h1>I make messy data behave.</h1>
        <p class="lead">
          I write about data, automation, reporting systems, and the surprisingly human problems hiding behind technical work.
        </p>
        <div class="actions">
          <a class="primary" href={url('/about/')}>Meet George</a>
          <a class="secondary" href={url('/blog/')}>Read the notes</a>
        </div>
        <p class="micro mono">SQL · Power BI · Python · integrations · rubber-duck debugging</p>
      </div>

      <div class="art-wrap">
        <div class="char-stage"><img class="char" src={url('/illustrations/characters/george-idea.webp')} alt="George in a blue hoodie, hand on chin, with a lightbulb thought bubble" /></div>
        <span class="sticker sticker-a">SELECT *</span>
        <span class="sticker sticker-b">♪</span>
      </div>
    </section>

    <section class="container strip" aria-label="Topics">
      <span>Data & BI</span><i>→</i>
      <span>Automation</span><i>→</i>
      <span>Integration</span><i>→</i>
      <span>Technical writing</span>
      <img class="char strip-cat" src={url('/illustrations/characters/cat-walking.webp')} alt="" loading="lazy" />
    </section>

    <section class="container editorial">
      <div>
        <p class="eyebrow">what lives here</p>
        <h2>Useful technical work, explained like a person.</h2>
      </div>
      <p>
        I’m interested in the layer between business questions and technical systems: how data moves,
        why reports become hard to trust, what makes an automation maintainable, and how small design choices
        make tools easier for people to actually use.
      </p>
    </section>

    <section class="container cards">
      <a class="card blue" href={url('/blog/')}>
        <span class="mono">01 / WRITING</span>
        <h3>Notes from the messy middle</h3>
        <p>Architecture, debugging, data quality, BI, process design, and lessons from building.</p>
        <b>Read writing →</b>
      </a>
      <a class="card yellow" href={url('/projects/')}>
        <span class="mono">02 / PROJECTS</span>
        <h3>Systems that solve real work</h3>
        <p>Selected examples of reporting automation, data integration, and internal tools.</p>
        <b>See projects →</b>
      </a>
      <a class="card white" href={url('/about/')}>
        <span class="mono">03 / HUMAN</span>
        <h3>There is music in the database</h3>
        <p>Cats, choir, guitars, wired headphones, tiny figures, and a few debugging ducks.</p>
        <b>About George →</b>
      </a>
    </section>

    <section class="container business">
      <div class="business-copy">
        <p class="eyebrow">for teams & businesses</p>
        <h2>Good systems should make work feel lighter.</h2>
        <p>
          I’m particularly interested in data integration, reporting automation, business intelligence,
          and tools that replace repetitive manual work with something reliable and understandable.
        </p>
        <a href="mailto:hello@georgechoulakis.com">Start a conversation →</a>
      </div>
      <div class="duck mono">
        <span>QUACK</span>
        <div>debugging<br/>consultant</div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
.hero { min-height:72vh; display:grid; grid-template-columns:1.04fr .96fr; align-items:center; gap:50px; padding:72px 0 72px; }
h1 { font-size:clamp(3.6rem, 8vw, 7.6rem); line-height:.91; margin:18px 0 28px; letter-spacing:-.065em; max-width:780px; }
.lead { font-size:clamp(1.08rem,2vw,1.3rem); color:var(--muted); max-width:690px; }
.actions { display:flex; gap:12px; margin-top:30px; flex-wrap:wrap; }
.actions a { padding:12px 18px; border-radius:999px; border:1.5px solid #111; font-weight:800; }
.primary { background:var(--text); color:#fff; box-shadow:3px 3px 0 var(--yellow); }
.secondary { background:#fff; box-shadow:3px 3px 0 var(--blue); }
.micro { margin-top:22px; color:#7b8490; font-size:.72rem; }
.art-wrap { position:relative; transform:rotate(1.2deg); }
.art-wrap .char { width:min(100%,420px); }
.sticker { position:absolute; border:2px solid #111; background:#fff; border-radius:999px; padding:7px 12px; font-family:'JetBrains Mono', monospace; font-weight:700; box-shadow:3px 3px 0 #111; }
.sticker-a { top:-12px; right:28px; transform:rotate(5deg); }
.sticker-b { bottom:25px; left:-14px; background:var(--yellow); transform:rotate(-9deg); font-size:1.25rem; }
.strip { border-top:1px solid var(--border); border-bottom:1px solid var(--border); padding:20px 0; display:flex; justify-content:space-between; gap:18px; color:#5c6570; font-size:.9rem; font-weight:700; }
.strip { position:relative; align-items:center; }
.strip-cat { position:absolute; right:30%; top:-58px; height:66px; width:auto; }
.strip i { font-style:normal; color:#b0b5bb; }
.editorial { display:grid; grid-template-columns:1fr 1fr; gap:70px; padding:105px 0 70px; }
.editorial h2 { font-size:clamp(2.6rem,5vw,5rem); line-height:.98; letter-spacing:-.05em; margin:14px 0 0; }
.editorial > p { color:var(--muted); font-size:1.08rem; align-self:end; margin:0; }
.cards { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; }
.card { min-height:330px; border:2px solid #111; border-radius:var(--radius); padding:28px; display:flex; flex-direction:column; box-shadow:5px 5px 0 #111; transition:.18s transform; }
.card:hover { transform:translate(-3px,-3px); }
.card span { font-size:.72rem; }
.card h3 { font-size:1.9rem; line-height:1.05; letter-spacing:-.035em; margin:25px 0 14px; }
.card p { color:#4f5964; }
.card b { margin-top:auto; }
.blue { background:var(--blue-soft); }
.yellow { background:#fff3c8; }
.white { background:#fff; }
.business { margin-top:110px; border:2px solid #111; border-radius:34px; padding:50px; background:#fff; display:grid; grid-template-columns:1fr auto; align-items:center; gap:45px; box-shadow:7px 7px 0 #111; }
.business h2 { font-size:clamp(2.3rem,5vw,4.5rem); line-height:1; letter-spacing:-.045em; margin:15px 0 20px; max-width:800px; }
.business p:not(.eyebrow) { color:var(--muted); max-width:760px; }
.business a { display:inline-block; margin-top:13px; font-weight:800; }
.duck { width:150px; height:150px; border-radius:50%; background:var(--yellow); border:2px solid #111; display:grid; place-content:center; text-align:center; transform:rotate(5deg); box-shadow:5px 5px 0 var(--orange); }
.duck span { font-weight:800; font-size:1.05rem; }
.duck div { font-size:.66rem; margin-top:6px; }
@media(max-width:850px){
  .hero,.editorial,.business{grid-template-columns:1fr;}
  .hero{padding-top:35px;}
  .art-wrap{max-width:620px;}
  .cards{grid-template-columns:1fr;}
  .strip{overflow:auto; justify-content:flex-start; white-space:nowrap;}
  .duck{display:none;}
}
</style>
