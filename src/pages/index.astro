---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<Header />
<main>
  <section class="hero container">
    <div class="copy">
      <p class="eyebrow mono">hello, i’m george 👋</p>
      <h1>Data, systems, automation — and the occasional rubber duck.</h1>
      <p class="lead">
        I build data tools, automate reporting, and turn messy business processes into systems that actually work.
      </p>
      <div class="actions">
        <a class="primary" href="/about">About me</a>
        <a class="secondary" href="/blog">Read the blog</a>
      </div>
    </div>
    <div class="art-card">
      <div class="placeholder">Your doodle illustration goes here</div>
    </div>
  </section>

  <section class="container grid">
    <article>
      <span class="mono tag">01</span>
      <h2>Data & BI</h2>
      <p>SQL, Power BI, reporting layers, data models, and practical analytics for everyday business decisions.</p>
    </article>
    <article>
      <span class="mono tag">02</span>
      <h2>Automation & Integration</h2>
      <p>Reducing repetitive work by connecting tools, building reliable flows, and making processes easier to maintain.</p>
    </article>
    <article>
      <span class="mono tag">03</span>
      <h2>Technical Notes</h2>
      <p>What I learn while building: architecture notes, debugging stories, patterns, and the occasional failed experiment.</p>
    </article>
  </section>

  <section class="container intro">
    <p class="eyebrow mono">about this place</p>
    <h2>A technical blog that still feels human.</h2>
    <p>
      This is where I write about data engineering, business intelligence, automation, systems thinking, and the projects behind them.
      Outside of work, you will probably find music, cats, tiny toy figures, and a suspicious number of rubber ducks somewhere in the mix.
    </p>
  </section>
</main>
<Footer />

<style>
.hero { min-height:68vh; display:grid; grid-template-columns:1.15fr .85fr; align-items:center; gap:60px; padding:80px 0 60px; }
.eyebrow { color:#4b6b88; font-size:.82rem; letter-spacing:.08em; text-transform:uppercase; }
h1 { font-size:clamp(3rem, 7vw, 6.6rem); line-height:.98; margin:16px 0 24px; letter-spacing:-.05em; max-width:900px; }
.lead { font-size:1.2rem; color:var(--muted); max-width:700px; }
.actions { display:flex; gap:12px; margin-top:28px; flex-wrap:wrap; }
.actions a { padding:12px 18px; border-radius:999px; border:1px solid var(--border); font-weight:700; }
.primary { background:var(--text); color:#fff; }
.secondary { background:#fff; }
.art-card { min-height:430px; border:2px solid #111; border-radius:32px; background:var(--blue-soft); display:grid; place-items:center; transform:rotate(1.5deg); }
.placeholder { color:#54708a; font-weight:700; text-align:center; padding:30px; }
.grid { display:grid; grid-template-columns:repeat(3,1fr); gap:22px; margin-top:30px; }
.grid article { border-top:1px solid var(--border); padding-top:22px; }
.tag { color:#8d98a5; font-size:.8rem; }
.grid h2 { margin:.35rem 0; font-size:1.35rem; }
.grid p, .intro p { color:var(--muted); }
.intro { max-width:820px; margin-top:110px; }
.intro h2 { font-size:clamp(2rem,4vw,3.6rem); line-height:1.05; margin:.4rem 0 1.2rem; letter-spacing:-.03em; }
@media (max-width: 800px) {
  .hero { grid-template-columns:1fr; padding-top:40px; }
  .art-card { min-height:280px; }
  .grid { grid-template-columns:1fr; }
}
</style>
