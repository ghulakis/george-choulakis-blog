---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<Header />
<main class="container page">
  <p class="mono eyebrow">projects</p>
  <h1>Things I build.</h1>
  <p class="lead">A home for selected data, automation, and integration projects.</p>

  <div class="project-grid">
    <div class="card">
      <p class="mono">Case study</p>
      <h2>Reporting automation</h2>
      <p>How a recurring manual reporting workflow can become a reliable, traceable system.</p>
    </div>
    <div class="card">
      <p class="mono">Case study</p>
      <h2>Data integration</h2>
      <p>Patterns for bringing operational data together without turning maintenance into a second full-time job.</p>
    </div>
  </div>
</main>
<Footer />

<style>
.page { padding-top:70px; }
.eyebrow { color:#4b6b88; text-transform:uppercase; letter-spacing:.08em; font-size:.82rem; }
h1 { font-size:clamp(3rem,7vw,6rem); line-height:1; letter-spacing:-.05em; margin:.3rem 0 1.3rem; }
.lead { color:var(--muted); font-size:1.2rem; }
.project-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:20px; margin-top:50px; }
.card { border:1px solid var(--border); border-radius:24px; padding:28px; background:#fff; }
.card p { color:var(--muted); }
.card .mono { color:#8b98a5; font-size:.8rem; }
@media (max-width:700px){ .project-grid{grid-template-columns:1fr;} }
</style>
