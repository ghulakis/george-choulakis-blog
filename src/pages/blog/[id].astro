---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({data}) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = new Intl.DateTimeFormat('en', { day:'2-digit', month:'long', year:'numeric' });
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout
  title={`${post.data.title} — George Choulakis`}
  description={post.data.description}
  image={post.data.image}
  type="article"
>
  <main class="container article">
    <a class="back mono" href={base + '/blog/'}>← writing</a>
    <p class="meta mono">
      {fmt.format(post.data.pubDate)}
      {post.data.readingTime && <> · {post.data.readingTime}</>}
      {post.data.tags.length > 0 && <> · {post.data.tags.join(' · ')}</>}
    </p>
    <h1>{post.data.title}</h1>
    <p class="dek">{post.data.description}</p>

    {post.data.image && (
      <img class="hero" src={`${base}${post.data.image}`} alt={post.data.title} />
    )}

    <article class="prose">
      <Content />
    </article>
  </main>
</BaseLayout>

<style>
.article { max-width:860px; padding-top:65px; }
.back { font-size:.78rem; color:#61707d; }
.meta { margin-top:55px; font-size:.74rem; color:#8c949e; text-transform:uppercase; letter-spacing:.06em; }
h1 { font-size:clamp(3rem,7vw,6.5rem); line-height:.96; letter-spacing:-.058em; margin:15px 0 24px; }
.dek { color:var(--muted); font-size:1.25rem; max-width:760px; }
.hero { width:100%; height:auto; display:block; margin:42px 0 0; border-radius:22px; border:1px solid var(--border); background:#f7f3ea; }
article { margin-top:55px; border-top:1px solid var(--border); padding-top:30px; }
article :global(h2) { margin-top:2.8rem; font-size:2rem; letter-spacing:-.03em; }
article :global(h3) { margin-top:2rem; font-size:1.2rem; letter-spacing:-.015em; }
article :global(p), article :global(li) { font-size:1.08rem; color:#4f5964; line-height:1.72; }
article :global(strong) { color:var(--text); }
article :global(ul), article :global(ol) { padding-left:1.35rem; }
article :global(blockquote) {
  margin:1.35rem 0;
  padding:1.05rem 1.2rem;
  border:1px solid var(--border);
  border-left:4px solid #9db4c8;
  border-radius:14px;
  background:#f8fafb;
}
article :global(blockquote p) { margin:.35rem 0; }
article :global(blockquote p:first-child) {
  color:var(--text);
  font-size:.82rem;
  font-weight:700;
  letter-spacing:.055em;
  text-transform:uppercase;
}
article :global(.dots) {
  text-align:center;
  letter-spacing:.45em;
  color:#aab5c0;
  margin:2.4rem 0;
}
article :global(a) { text-decoration:underline; text-underline-offset:3px; }
@media(max-width:650px){
  .article { padding-top:40px; }
  .meta { margin-top:38px; line-height:1.7; }
  h1 { font-size:clamp(2.7rem,13vw,4.6rem); }
  .dek { font-size:1.08rem; }
  .hero { margin-top:30px; border-radius:16px; }
  article { margin-top:38px; }
  article :global(h2) { font-size:1.65rem; }
  article :global(p), article :global(li) { font-size:1rem; }
}
</style>
