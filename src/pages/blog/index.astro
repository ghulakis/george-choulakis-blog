---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('blog', ({data}) => !data.draft))
  .sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = new Intl.DateTimeFormat('en', { day:'2-digit', month:'short', year:'numeric' });
---
<BaseLayout title="Writing — George Choulakis" description="Technical notes on data, automation, BI, integration, and the systems behind business work.">
  <main class="container page">
    <div class="page-head">
      <div>
        <p class="eyebrow">writing</p>
        <h1>Notes from the messy middle.</h1>
        <p class="lead">Data, automation, reporting systems, architecture, and the practical details that usually get left out.</p>
      </div>
      <img class="char" src={`${base}/illustrations/characters/george-reading.webp`} alt="George reading a book" />
    </div>

    {posts.length === 0 && (
      <div class="empty">
        <img class="char" src={`${base}/illustrations/characters/cat-sleeping.webp`} alt="A sleeping cat" />
        <p>Nothing published yet. The cat is guarding the drafts.</p>
      </div>
    )}
    <div class="posts">
      {posts.map((post, index) => (
        <a class="post" href={`${base}/blog/${post.id}/`}>
          <div class="number mono">{String(index + 1).padStart(2,'0')}</div>
          <div>
            <div class="meta mono">{fmt.format(post.data.pubDate)} · {post.data.tags.join(' · ')}</div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
          </div>
          <div class="arrow">↗</div>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
.empty { display:grid; justify-items:center; gap:10px; padding:60px 0; color:var(--muted); }
.empty .char { width:220px; }
.page { padding-top:75px; }
h1 { font-size:clamp(3.5rem,8vw,7rem); max-width:940px; line-height:.94; letter-spacing:-.06em; margin:16px 0 24px; }
.lead { max-width:760px; color:var(--muted); font-size:1.2rem; }
.posts { margin-top:70px; border-top:1px solid var(--border); }
.post { display:grid; grid-template-columns:70px 1fr auto; gap:22px; padding:30px 0; border-bottom:1px solid var(--border); align-items:start; }
.post:hover h2 { text-decoration:underline; text-decoration-thickness:2px; text-underline-offset:5px; }
.number,.meta { color:#8c949e; font-size:.72rem; }
.post h2 { margin:.5rem 0 .5rem; font-size:clamp(1.5rem,3vw,2.25rem); letter-spacing:-.035em; }
.post p { color:var(--muted); max-width:760px; margin:0; }
.arrow { font-size:1.5rem; }
@media(max-width:650px){ .post{grid-template-columns:1fr auto;} .number{display:none;} }
</style>
