---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const roles = [
  {
    period: 'Nov 2025 — Present',
    company: 'NEW YORKER',
    role: 'Sales Data & Integration Specialist',
    location: 'Braunschweig, Germany',
    domain: 'newyorker.de',
    summary: 'Sales data, integrations, reporting processes, and internal tools in a large retail environment.',
    tags: ['SQL Server', 'Power BI', 'Automation', 'Integration'],
    milestone: 'Moving deeper into operational data architecture and business applications.'
  },
  {
    period: 'Dec 2024 — Oct 2025',
    company: 'Airline client',
    role: 'Freelance Revenue Controller',
    location: 'Athens, Greece',
    domain: null,
    summary: 'Revenue-control and reporting work combining financial analysis with operational data.',
    tags: ['Revenue', 'Reporting', 'Excel', 'Analysis'],
    milestone: 'Independent project work sharpened my focus on business-facing analytics.'
  },
  {
    period: 'Aug 2023 — Nov 2024',
    company: 'JACK WOLFSKIN',
    role: 'FP&A Reporting Specialist',
    location: 'Germany',
    domain: 'jack-wolfskin.com',
    summary: 'FP&A reporting, planning support, and analytics with a strong BI and finance-data focus.',
    tags: ['FP&A', 'SAP Analytics Cloud', 'Power BI', 'Reporting'],
    milestone: 'Expanded from operational reporting into finance and planning.'
  },
  {
    period: 'Feb 2022 — May 2023',
    company: 'Philip Morris International',
    role: 'e-Business Distribution Executive',
    location: 'Athens, Greece',
    domain: 'pmi.com',
    summary: 'Commercial and distribution analytics for e-business, including reporting, process design, stock-related data, and cross-functional coordination.',
    tags: ['e-Commerce', 'Analytics', 'SAP', 'Process'],
    milestone: 'Returned to a commercial role with stronger engineering and systems thinking.'
  },
  {
    period: 'Aug 2021 — Jan 2022',
    company: 'EY',
    role: 'Junior Data Engineer',
    location: 'Athens, Greece',
    domain: 'ey.com',
    summary: 'Designed and tested ETL processes, supported data warehousing work, debugging, and UAT documentation.',
    tags: ['Data Engineering', 'SQL', 'ETL', 'Consulting'],
    milestone: 'A deliberate move into data engineering to deepen the technical side of my profile.'
  },
  {
    period: 'Dec 2020 — Jul 2021',
    company: 'Philip Morris International',
    role: 'Reporting & Systems Executive',
    location: 'Athens, Greece',
    domain: 'pmi.com',
    summary: 'Reporting systems, operational reporting, dashboards, and internal tools supporting commercial teams.',
    tags: ['SQL Server', 'Power BI', 'Reporting', 'Systems'],
    milestone: 'Promoted after building reporting solutions and documenting processes.'
  },
  {
    period: 'Jul 2019 — Nov 2020',
    company: 'Philip Morris International',
    role: 'e-Commerce Deployment Executive',
    location: 'Athens, Greece',
    domain: 'pmi.com',
    summary: 'Collected and analysed e-commerce data, supported digital sales reporting, and worked across customer-care and logistics processes.',
    tags: ['e-Commerce', 'Operations', 'Data', 'Deployment'],
    milestone: 'Started through INKOMPASS and transitioned into a full-time role.'
  },
];

const side = [
  {
    title: 'Education',
    body: 'Athens University of Economics and Business — studies spanning information systems, organizational management, and commercial data analysis.'
  },
  {
    title: 'Recognition',
    body: 'Received an Above & Beyond Call of Duty (ABCD) Award in 2022 for work around a finance and internal-control inventory reporting solution.'
  },
  {
    title: 'Through-line',
    body: 'Commercial operations → reporting → data engineering → FP&A → integration. The titles changed, but the work kept moving toward systems thinking.'
  }
];
---
<BaseLayout title="Career Timeline — George Choulakis" description="Career timeline of George Choulakis across data, reporting, e-commerce, FP&A and integration roles.">
  <main class="container page">
    <div class="page-head">
      <div>
        <p class="eyebrow">my journey</p>
        <h1>A career built by following the data upstream.</h1>
      </div>
      <img class="char" src={`${base}/illustrations/characters/toy-figure-waving.webp`} alt="A small toy figure waving hello" />
    </div>
    <p class="lead">
      I started close to commercial operations and gradually moved deeper into reporting, engineering,
      finance analytics, and integration. Each step added another layer to how I understand a business system.
    </p>

    <section class="journey">
      <div class="timeline">
        {roles.map((item, index) => (
          <article class="item">
            <div class="rail">
              <span class="dot">{String(index + 1).padStart(2,'0')}</span>
              {index < roles.length - 1 && <span class="line"></span>}
            </div>

            <div class="card">
              <div class="top">
                <div class="logo-wrap">
                  {item.domain
                    ? <img src={`https://logo.clearbit.com/${item.domain}`} alt={`${item.company} logo`} loading="lazy" onerror="this.style.display='none'" />
                    : <span class="logo-fallback">✈</span>}
                </div>
                <div>
                  <div class="period mono">{item.period}</div>
                  <h2>{item.role}</h2>
                  <h3>{item.company}</h3>
                  <p class="location">{item.location}</p>
                </div>
              </div>

              <p class="summary">{item.summary}</p>

              <div class="milestone">
                <span class="mono">WHY THIS STEP MATTERED</span>
                <p>{item.milestone}</p>
              </div>

              <div class="tags">
                {item.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </div>
          </article>
        ))}
      </div>

      <aside class="side">
        {side.map((box) => (
          <div class="side-card">
            <span class="mono">{box.title}</span>
            <p>{box.body}</p>
          </div>
        ))}
      </aside>
    </section>

    <section class="closing">
      <img class="char closing-char" src={`${base}/illustrations/characters/george-excited.webp`} alt="George smiling with both fists raised" loading="lazy" />
      <p class="eyebrow">what connects the dots</p>
      <h2>I keep moving closer to the architecture of how work gets done.</h2>
      <p>
        The common thread is not a single tool or industry. It is the habit of looking at a process,
        finding the data behind it, understanding the systems around it, and making the whole thing clearer.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
.page-head .char { width:clamp(110px,14vw,170px); }
.closing-char { float:right; width:clamp(130px,16vw,190px); margin:0 0 10px 24px; }
.page { padding-top:75px; }
h1 { font-size:clamp(3.4rem,7.5vw,7rem); line-height:.94; letter-spacing:-.06em; margin:16px 0 24px; max-width:1050px; }
.lead { max-width:850px; color:var(--muted); font-size:1.2rem; }
.journey { display:grid; grid-template-columns:minmax(0,1fr) 290px; gap:50px; margin-top:75px; }
.item { display:grid; grid-template-columns:70px 1fr; gap:20px; align-items:stretch; }
.rail { position:relative; display:flex; flex-direction:column; align-items:center; }
.dot { width:48px; height:48px; border:2px solid #111; border-radius:50%; background:var(--yellow); display:grid; place-items:center; font-family:'JetBrains Mono', monospace; font-size:.72rem; font-weight:800; box-shadow:3px 3px 0 #111; z-index:1; }
.line { width:2px; background:#111; flex:1; margin:7px 0; min-height:45px; }
.card { border:1.5px solid #111; border-radius:28px; background:#fff; padding:28px; margin-bottom:28px; box-shadow:5px 5px 0 rgba(21,23,26,.10); }
.top { display:grid; grid-template-columns:100px 1fr; gap:22px; align-items:start; }
.logo-wrap { min-height:76px; border:1px solid var(--border); border-radius:18px; display:grid; place-items:center; padding:12px; background:#fff; }
.logo-wrap img { max-width:100%; max-height:48px; object-fit:contain; }
.logo-fallback { font-size:2rem; }
.period { color:#7c8791; font-size:.72rem; text-transform:uppercase; letter-spacing:.05em; }
.card h2 { margin:.4rem 0 .15rem; font-size:clamp(1.7rem,3vw,2.45rem); letter-spacing:-.035em; }
.card h3 { margin:0; font-size:1.05rem; }
.location { color:var(--muted); margin:.2rem 0 0; font-size:.9rem; }
.summary { color:#505a64; max-width:820px; margin:24px 0 18px; }
.milestone { border-left:4px solid var(--yellow); padding:10px 0 10px 16px; margin:6px 0 20px; }
.milestone span { font-size:.66rem; color:#7a838d; }
.milestone p { margin:.3rem 0 0; font-weight:700; color:#333b43; }
.tags { display:flex; flex-wrap:wrap; gap:8px; }
.tags span { border:1px solid #111; border-radius:999px; padding:5px 9px; font-size:.74rem; background:var(--blue-soft); }
.side { display:flex; flex-direction:column; gap:18px; }
.side-card { position:sticky; top:24px; border:1.5px solid #111; border-radius:22px; background:#fff3c8; padding:22px; box-shadow:4px 4px 0 #111; }
.side-card:nth-child(2){ top:220px; background:var(--blue-soft); }
.side-card:nth-child(3){ top:420px; background:#fff; }
.side-card span { font-size:.7rem; font-weight:800; }
.side-card p { color:#505a64; margin:.6rem 0 0; font-size:.92rem; }
.closing { margin:100px 0 30px; max-width:850px; }
.closing h2 { font-size:clamp(2.4rem,5vw,4.5rem); line-height:1; letter-spacing:-.045em; margin:15px 0; }
.closing > p:last-child { color:var(--muted); }
@media(max-width:900px){
  .journey{grid-template-columns:1fr;}
  .side{display:grid; grid-template-columns:1fr;}
  .side-card,.side-card:nth-child(2),.side-card:nth-child(3){position:static;}
}
@media(max-width:700px){
  .item{grid-template-columns:44px 1fr; gap:12px;}
  .dot{width:38px;height:38px;}
  .top{grid-template-columns:1fr;}
  .logo-wrap{width:120px;}
}
</style>
